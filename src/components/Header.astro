---
import { locales, localeLabels, type Locale } from '@/i18n/config';
import { useTranslations } from '@/i18n/utils';
import Logo from './Logo.astro';

interface Props { lang: Locale }
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<header class="header">
  <div class="container--wide bar">
    <Logo href={`/${lang}/`} />

    <nav class="nav" aria-label="Main">
      <a href="#products">{t.nav.products}</a>
      <a href="#approach">{t.nav.approach}</a>
      <a href="#about">{t.nav.about}</a>
      <a href="#contact">{t.nav.contact}</a>
    </nav>

    <div class="lang">
      {locales.map((l) => (
        <a href={`/${l}/`} hreflang={l} aria-current={l === lang ? 'true' : undefined}>{localeLabels[l]}</a>
      ))}
    </div>
  </div>
</header>

<style>
  .header {
    position: sticky; top: 0; z-index: 100;
    height: var(--header-h);
    background: rgb(250 250 252 / 0.8);
    backdrop-filter: saturate(180%) blur(20px);
    -webkit-backdrop-filter: saturate(180%) blur(20px);
    border-bottom: 1px solid rgb(0 0 0 / 0.08);
  }
  .bar { height: 100%; display: flex; align-items: center; justify-content: space-between; padding-inline: 10px; }
  .nav { display: flex; gap: clamp(20px, 3vw, 40px); font-size: 12px; letter-spacing: -0.01em; }
  .nav a { color: rgb(0 0 0 / 0.8); transition: color 0.32s cubic-bezier(0.4, 0, 0.6, 1); }
  .nav a:hover { color: #000; }
  .lang { display: flex; gap: 10px; font-size: 12px; }
  .lang a { color: var(--c-muted); }
  .lang a[aria-current] { color: var(--c-text); font-weight: 600; }
  @media (max-width: 734px) { .nav { display: none; } }
</style>
