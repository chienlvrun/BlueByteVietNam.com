---
interface Props { href: string; size?: number }
const { href, size = 20 } = Astro.props;
---

<a href={href} class="logo" aria-label="BlueByte Vietnam">
  <svg width={size} height={size} viewBox="0 0 20 20" aria-hidden="true">
    <rect x="0" y="0" width="9" height="9" rx="2.2" fill="currentColor" />
    <rect x="11" y="0" width="9" height="9" rx="2.2" fill="currentColor" opacity="0.35" />
    <rect x="0" y="11" width="9" height="9" rx="2.2" fill="currentColor" opacity="0.35" />
    <rect x="11" y="11" width="9" height="9" rx="2.2" fill="var(--c-blue)" />
  </svg>
  <span>BlueByte</span>
</a>

<style>
  .logo { display: inline-flex; align-items: center; gap: 8px; font-weight: 600; font-size: 15px; letter-spacing: -0.01em; }
</style>
