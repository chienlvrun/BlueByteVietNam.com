---
import { logoCells, LOGO_CELL, LOGO_RADIUS, LOGO_SIZE } from '@/data/brand';

interface Props { href: string; size?: number }
const { href, size = 22 } = Astro.props;
---

<a href={href} class="logo" aria-label="BlueByte Vietnam">
  <svg width={size} height={size} viewBox={`0 0 ${LOGO_SIZE} ${LOGO_SIZE}`} aria-hidden="true">
    {logoCells.map((c) => (
      <rect x={c.x} y={c.y} width={LOGO_CELL} height={LOGO_CELL} rx={LOGO_RADIUS} fill={c.fill} />
    ))}
  </svg>
  <span>BlueByte</span>
</a>

<style>
  .logo { display: inline-flex; align-items: center; gap: 8px; font-weight: 600; font-size: 15px; letter-spacing: -0.01em; }
</style>
