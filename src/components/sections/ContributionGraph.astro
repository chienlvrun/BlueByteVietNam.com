---
// Biểu đồ đóng góp kiểu GitHub: 7 hàng (CN → T7), mỗi cột là một tuần, cột cuối là tuần hiện tại.
// Các ô đậm nhất "viết" chữ BLUEBYTE VN trên nền commit dày đặc — team làm việc mỗi ngày.
//
// Animation "khó đoán": ô chữ ban đầu chỉ nhạt như mọi ngày khác (ngụy trang), sau đó chuyển
// sang đậm theo thứ tự ngẫu nhiên, chậm lúc đầu và nhanh dần — càng về cuối chữ mới càng rõ.
// Trong giai đoạn đầu, vài ô nền cũng loé đậm rồi tắt để đánh lạc hướng.
// Toàn bộ thời gian được tính khi build — chỉ dùng CSS animation, không có JS phía client.
import { t } from '@/content';


const GLYPHS: Record<string, string[]> = {
  B: ['111.', '1..1', '111.', '1..1', '111.'],
  L: ['1...', '1...', '1...', '1...', '1111'],
  U: ['1..1', '1..1', '1..1', '1..1', '.11.'],
  E: ['1111', '1...', '111.', '1...', '1111'],
  Y: ['1...1', '.1.1.', '..1..', '..1..', '..1..'],
  T: ['11111', '..1..', '..1..', '..1..', '..1..'],
  V: ['1...1', '1...1', '1...1', '.1.1.', '..1..'],
  N: ['1...1', '11..1', '1.1.1', '1..11', '1...1'],
  ' ': ['.', '.', '.', '.', '.'],
};
const TEXT = 'BLUEBYTE VN';
const DAYS = 7;
const GLYPH_TOP = 1; // hàng T2 → T6 chứa chữ
const LETTER_GAP = 1;
const PAD_COLS = 1;

// Nhịp animation (ms).
const COMMIT_START = 300; // các commit nền bắt đầu hiện
const COMMIT_SPREAD = 1100; // ...rải ngẫu nhiên trong khoảng này
const REVEAL_START = 1500; // chữ bắt đầu lộ ra
const REVEAL_DURATION = 3000; // thời gian để toàn bộ chữ lộ ra
const REVEAL_EASE = 0.6; // < 1: chậm lúc đầu, nhanh dần về cuối
const DECOY_RATIO = 0.12; // tỉ lệ ô nền loé đậm để đánh lạc hướng
const DECOY_WINDOW = 0.55; // ô đánh lạc hướng chỉ xuất hiện trong 55% đầu của giai đoạn lộ chữ
const SPARKLE_EVERY = 13;
const REVEAL_END = REVEAL_START + REVEAL_DURATION + 500;

// Nhiễu giả ngẫu nhiên nhưng cố định giữa các lần build.
const hash = (a: number, b: number) => Math.abs(Math.sin(a * 12.9898 + b * 78.233) * 43758.5453) % 1;

// ---- Bố cục chữ ----
const textWidth = [...TEXT].reduce((w, ch) => w + GLYPHS[ch][0].length, 0) + (TEXT.length - 1) * LETTER_GAP;
const COLUMNS = textWidth + PAD_COLS * 2;

const letterKeys: string[] = [];
let x = PAD_COLS;
for (const ch of TEXT) {
  const glyph = GLYPHS[ch];
  glyph.forEach((line, r) =>
    [...line].forEach((bit, c) => bit === '1' && letterKeys.push(`${x + c},${GLYPH_TOP + r}`)),
  );
  x += glyph[0].length + LETTER_GAP;
}

// Thứ tự lộ chữ: xáo trộn ngẫu nhiên, thời điểm theo đường cong chậm → nhanh.
const shuffled = letterKeys
  .map((key) => {
    const [cx, cy] = key.split(',').map(Number);
    return { key, order: hash(cx * 7.1, cy * 3.3) };
  })
  .sort((a, b) => a.order - b.order);
const revealAt = new Map(
  shuffled.map(({ key }, i) => [
    key,
    Math.round(REVEAL_START + REVEAL_DURATION * ((i + 1) / shuffled.length) ** REVEAL_EASE),
  ]),
);

// ---- Lịch: cột cuối chứa hôm nay ----
const DAY_MS = 86_400_000;
const today = new Date();
today.setHours(0, 0, 0, 0);
const todayRow = today.getDay();
const firstSunday = new Date(today.getTime() - (todayRow + (COLUMNS - 1) * 7) * DAY_MS);
const dateOf = (col: number, row: number) => new Date(firstSunday.getTime() + (col * 7 + row) * DAY_MS);

// Nhãn tháng: đặt ở cột đầu tiên mà tháng thay đổi (giống GitHub), bỏ nhãn quá sát mép.
const months: { col: number; label: string }[] = [];
for (let col = 0; col < COLUMNS; col++) {
  const m = dateOf(col, 0).getMonth();
  const prev = col === 0 ? -1 : dateOf(col - 1, 0).getMonth();
  if (m !== prev && col <= COLUMNS - 3) months.push({ col, label: t.graph.months[m] });
}
if (months.length > 1 && months[1].col - months[0].col < 3) months.shift();

// Nền dày đặc commit để thể hiện team làm việc liên tục: ngày thường gần như kín,
// cuối tuần thưa hơn một chút. Nền tối đa mức 2 để chữ (mức 4) luôn nổi rõ.
function noiseLevel(col: number, row: number): number {
  const n = hash(col, row);
  const weekend = row === 0 || row === DAYS - 1;
  if (weekend) return n > 0.9 ? 2 : n > 0.3 ? 1 : 0;
  return n > 0.84 ? 2 : n > 0.08 ? 1 : 0;
}

// ---- Ô ----
const cells: { cls: string; style: string }[] = [];
let letterIndex = 0;
for (let col = 0; col < COLUMNS; col++) {
  for (let row = 0; row < DAYS; row++) {
    const future = col === COLUMNS - 1 && row > todayRow;
    const isToday = col === COLUMNS - 1 && row === todayRow;
    const reveal = revealAt.get(`${col},${row}`);
    const commit = COMMIT_START + Math.round(hash(row * 5.3, col * 1.7) * COMMIT_SPREAD);

    if (future) {
      cells.push({ cls: 'cell future', style: '' });
      continue;
    }

    if (reveal !== undefined) {
      const level = hash(col * 3, row) > 0.94 ? 3 : 4;
      const sparkle = letterIndex++ % SPARKLE_EVERY === 6;
      const spark = sparkle ? `;--spark:${REVEAL_END + Math.round(hash(col, row * 9) * 7000)}ms` : '';
      cells.push({
        cls: `cell g${level} letter${sparkle ? ' sparkle' : ''}`,
        style: `--day:${commit}ms;--reveal:${reveal}ms${spark}`,
      });
      continue;
    }

    const level = isToday ? 2 : noiseLevel(col, row);
    if (level === 0) {
      cells.push({ cls: 'cell g0', style: '' });
      continue;
    }
    const decoy = !isToday && hash(col * 2.9, row * 4.1) < DECOY_RATIO;
    const decoyAt = REVEAL_START + Math.round(hash(col, row * 2) * REVEAL_DURATION * DECOY_WINDOW);
    cells.push({
      cls: `cell g${level} commit${decoy ? ' decoy' : ''}${isToday ? ' today' : ''}`,
      style: `--day:${commit}ms;--end:${REVEAL_END}ms${decoy ? `;--decoy:${decoyAt}ms` : ''}`,
    });
  }
}
---

<figure class="graph" style={`--cols:${COLUMNS}`} aria-hidden="true">
  <div class="months">
    {months.map((m) => <span style={`grid-column:${m.col + 1}`}>{m.label}</span>)}
  </div>
  <div class="body">
    <div class="days">
      <span></span><span>{t.graph.days[0]}</span><span></span><span>{t.graph.days[1]}</span><span></span><span>{t.graph.days[2]}</span><span></span>
    </div>
    <div class="cells">
      {cells.map((c) => <span class={c.cls} style={c.style}></span>)}
    </div>
  </div>
  <figcaption class="foot">
    <span>{t.graph.caption}</span>
    <span class="legend">
      {t.graph.less}
      <i class="g0"></i><i class="g1"></i><i class="g2"></i><i class="g3"></i><i class="g4"></i>
      {t.graph.more}
    </span>
  </figcaption>
</figure>

<style>
  .graph {
    --g0: #ebedf0;
    /* 5 mức xanh dương đồng bộ với màu nút (#0071e3). */
    --g1: #c6dffc;
    --g2: #79b5f7;
    --g3: #0071e3;
    --g4: #0050a6;
    --day-col: 30px;
    --gap: clamp(2px, 0.35vw, 4px);

    width: min(100% - 24px, 980px);
    margin: clamp(48px, 7vw, 88px) auto 0;
    padding: clamp(12px, 2vw, 20px) clamp(12px, 2vw, 20px) clamp(10px, 1.5vw, 16px);
    border: 1px solid #d0d7de;
    border-radius: 6px;
    background: #fff;
    text-align: left;
    font-size: 12px;
    letter-spacing: 0;
    color: #57606a;
    animation: fade 0.6s var(--ease) both;
  }
  .months {
    display: grid;
    grid-template-columns: repeat(var(--cols), minmax(0, 1fr));
    column-gap: var(--gap);
    margin-left: var(--day-col);
    overflow: hidden;
    margin-bottom: 6px;
    line-height: 1;
  }
  .months span { white-space: nowrap; }
  .body { display: flex; min-width: 0; }
  .days {
    flex: 0 0 var(--day-col);
    display: grid;
    grid-template-rows: repeat(7, 1fr);
    row-gap: var(--gap);
    font-size: 11px;
  }
  .days span { display: flex; align-items: center; line-height: 1; }
  .cells {
    flex: 1;
    min-width: 0;
    display: grid;
    grid-template-rows: repeat(7, auto);
    grid-auto-flow: column;
    grid-auto-columns: minmax(0, 1fr);
    gap: var(--gap);
  }
  .cell {
    aspect-ratio: 1;
    border-radius: 2px;
    outline: 1px solid rgb(27 31 36 / 0.06);
    outline-offset: -1px;
  }
  .future { visibility: hidden; }
  .g0 { background: var(--g0); }
  .g1 { background: var(--g1); }
  .g2 { background: var(--g2); }
  .g3 { background: var(--g3); }
  .g4 { background: var(--g4); }

  /*
   * Màu cuối cùng luôn là màu của class gN, nên khi tắt animation (reduced motion)
   * vẫn thấy đúng chữ. Thứ tự trong danh sách animation quan trọng: animation sau ghi đè animation trước.
   */
  .commit { animation: commit 0.5s ease-out backwards; animation-delay: var(--day); }
  .decoy {
    animation: commit 0.5s ease-out backwards, decoy 0.9s ease-in-out;
    animation-delay: var(--day), var(--decoy);
  }
  /* Ô chữ: trống → nhạt như mọi ngày (ngụy trang) → bật đậm tại --reveal. */
  .letter {
    animation: masked var(--reveal) linear, commit 0.5s ease-out backwards, reveal 0.5s ease-out;
    animation-delay: 0ms, var(--day), var(--reveal);
  }
  .sparkle {
    animation: masked var(--reveal) linear, commit 0.5s ease-out backwards, reveal 0.5s ease-out,
      sparkle 8s ease-in-out infinite;
    animation-delay: 0ms, var(--day), var(--reveal), var(--spark);
  }
  .today {
    animation: commit 0.5s ease-out backwards, today 2.4s ease-in-out infinite;
    animation-delay: var(--day), var(--end);
  }

  @keyframes fade { from { opacity: 0; transform: translateY(8px); } }
  @keyframes commit { from { background: var(--g0); } }
  @keyframes masked { from, to { background: var(--g1); } }
  @keyframes reveal {
    0% { background: var(--g2); transform: scale(1.35); box-shadow: 0 0 8px rgb(0 113 227 / 0.6); }
    100% { transform: scale(1); box-shadow: none; }
  }
  @keyframes decoy {
    25%, 65% { background: var(--g4); }
  }
  @keyframes sparkle {
    0%, 90%, 100% { filter: none; }
    94% { filter: brightness(1.9) saturate(1.2); }
  }
  @keyframes today {
    0%, 100% { box-shadow: 0 0 0 0 rgb(0 113 227 / 0); }
    50% { box-shadow: 0 0 0 3px rgb(0 113 227 / 0.3); }
  }

  .foot {
    display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 8px;
    margin-top: 12px;
    padding-left: var(--day-col);
  }
  .legend { display: inline-flex; align-items: center; gap: 3px; }
  .legend i { width: 10px; height: 10px; border-radius: 2px; outline: 1px solid rgb(27 31 36 / 0.06); outline-offset: -1px; }
  .legend i:first-of-type { margin-left: 4px; }
  .legend i:last-of-type { margin-right: 4px; }

  @media (max-width: 734px) {
    .graph { --day-col: 22px; --gap: 1px; width: calc(100% - 16px); padding-inline: 8px; font-size: 10px; }
    .cell { border-radius: 1px; }
    .months span:nth-child(even) { visibility: hidden; }
    .days { font-size: 9px; }
  }
</style>
