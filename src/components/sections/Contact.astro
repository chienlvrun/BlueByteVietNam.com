---
import { t } from '@/content';
import { company } from '@/data/site';

---

<section id="contact" class="section">
  <div class="container">
    <div class="headline">
      <h2>{t.contact.title}</h2>
      <p>{t.contact.text}</p>
    </div>
    <div class="cta-row">
      <a class="button button-elevated" href={`mailto:${company.email}`}>{t.contact.button}</a>
      <a class="text-link" href={`mailto:${company.email}`}>{company.email}</a>
    </div>
  </div>
</section>

<style>
  .headline { margin-bottom: 32px; }
</style>
