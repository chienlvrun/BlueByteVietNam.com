---
import { t } from '@/content';
import { company } from '@/data/site';
import { products } from '@/data/products';

---

<footer class="footer">
  <div class="container">
    <p class="note">{t.footer.location}</p>

    <div class="cols">
      <div>
        <h3>{t.footer.products}</h3>
        <ul role="list">
          {products.map((p) => <li><a href={p.url} target="_blank" rel="noopener">{p.name}</a></li>)}
        </ul>
      </div>
      <div>
        <h3>{t.footer.contact}</h3>
        <ul role="list">
          <li><a href={`mailto:${company.email}`}>{company.email}</a></li>
          <li><a href={`tel:${company.phone}`}>{company.phone}</a></li>
        </ul>
      </div>
    </div>

    <div class="legal">
      <p class="legal-name">{company.legalName} ({company.shortName})</p>
      <p>{t.footer.taxCode}: {company.taxCode} <span aria-hidden="true">|</span> {t.footer.representative}: {company.representative}</p>
      <p>{t.footer.address}: {company.address}</p>
    </div>

    <div class="bottom">
      <span>Copyright © {new Date().getFullYear()} {company.name}. {t.footer.rights}</span>
    </div>
  </div>
</footer>

<style>
  .footer { background: var(--c-bg-alt); color: var(--c-muted); font-size: 12px; letter-spacing: -0.01em; line-height: 1.33; padding-block: 20px 24px; }
  .note { padding-bottom: 16px; border-bottom: 1px solid var(--c-border); }
  .cols { display: flex; flex-wrap: wrap; gap: 24px 64px; padding-block: 20px; border-bottom: 1px solid var(--c-border); }
  h3 { font-size: 12px; font-weight: 600; color: var(--c-text); margin-bottom: 8px; }
  ul { list-style: none; padding: 0; display: grid; gap: 8px; }
  a:hover { text-decoration: underline; color: var(--c-text); }
  .legal { display: grid; gap: 4px; padding-block: 16px; border-bottom: 1px solid var(--c-border); }
  .legal-name { color: var(--c-text); }
  .legal span { margin-inline: 6px; color: var(--c-border); }
  .bottom { padding-top: 16px; }
</style>
